rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Common Primitives ---
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    // Check if the user is a known admin
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'shahinkhan28a@gmail.com' ||
        request.auth.token.email.lower() == 'shahinkhan28w@gmail.com'
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users Collection ---
    match /users/{userId} {
      // Users can read/write their own profile
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    // --- Orders Collection ---
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- Transactions Collection ---
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // --- Categories & Services ---
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Support Tickets ---
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // --- Support Messages ---
    match /messages/{messageId} {
      allow read, list: if isSignedIn() && (resource.data.roomId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (request.resource.data.senderId == request.auth.uid);
    }

    // --- Notifications, News, Affiliates, Child Panels ---
    match /notifications/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /affiliates/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
    }
    match /child_panels/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn() && (request.resource.data.userId == request.auth.uid || isAdmin());
    }

    // --- Settings ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /providers/{id} {
      allow read, write: if isAdmin();
    }
  }
}
